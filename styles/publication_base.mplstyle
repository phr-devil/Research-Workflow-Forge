# Research Workflow Forge | general publication baseline
# Apply only after the user explicitly requested creation of the images.
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white
savefig.transparent: False
text.color: black
axes.labelcolor: black
axes.edgecolor: black
xtick.color: black
ytick.color: black
font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans
font.size: 9
axes.labelsize: 11
axes.labelweight: bold
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
axes.linewidth: 1.2
lines.linewidth: 1.8
lines.markersize: 5
xtick.major.width: 1.0
ytick.major.width: 1.0
xtick.major.size: 4
ytick.major.size: 4
axes.spines.top: False
axes.spines.right: False
axes.grid: False
svg.fonttype: none
figure.autolayout: False
